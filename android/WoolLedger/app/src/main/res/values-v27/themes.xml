<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ 才有 windowLightNavigationBar；其余属性要和 values/themes.xml 保持一致，
         不要再用"只覆盖一半"的写法（丢 textViewStyle / edge-to-edge 配置不一致）。 -->
    <style name="Theme.Wool" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/WoolWindowAnimation</item>
        <item name="android:textViewStyle">@style/WoolTextBase</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">@color/blue2</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
    </style>

    <style name="Theme.Wool.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowAnimationStyle">@style/WoolWindowAnimation</item>
        <item name="android:textViewStyle">@style/WoolTextBase</item>
        <item name="android:windowBackground">@color/paper_dark</item>
        <item name="android:statusBarColor">@color/paper_dark</item>
        <item name="android:navigationBarColor">@color/paper_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorAccent">@color/sky</item>
        <item name="android:textColorPrimary">@color/ink_dark</item>
        <item name="android:textColorSecondary">@color/ink2_dark</item>
    </style>
</resources>