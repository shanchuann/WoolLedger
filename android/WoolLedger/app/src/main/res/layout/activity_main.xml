<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部悬浮导航：账单 / 统计 / 记一笔 / 我的 -->
    <FrameLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="78dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_nav"
        android:elevation="10dp">

        <!-- 选中胶囊：横向滑到目标项 -->
        <View
            android:id="@+id/nav_indicator"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nav_item_on" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/tab_bills"
            style="@style/NavItem">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_nav_bills"
                app:tint="@color/ink2"
        android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_bills"
                android:textColor="@color/ink2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_stats"
            style="@style/NavItem">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_nav_stats"
                app:tint="@color/ink2"
        android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_stats"
                android:textColor="@color/ink2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_add"
            style="@style/NavItem">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_nav_add"
                app:tint="@color/ink2"
        android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_add"
                android:textColor="@color/ink2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_me"
            style="@style/NavItem">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_nav_me"
                app:tint="@color/ink2"
        android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_me"
                android:textColor="@color/ink2"
                android:textSize="11sp" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 蓝羊羊入口 -->
    <ImageView
        android:id="@+id/nav_ai"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_ai_face"
        android:contentDescription="蓝羊羊"
        android:elevation="10dp" />

    <!-- 深浅色切换，所有页面共用 -->
    <ImageView
        android:id="@+id/theme_toggle"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_round_white"
        android:elevation="6dp"
        android:padding="7dp"
        android:src="@drawable/ic_moon"
        android:contentDescription="切换深色模式" />
</FrameLayout>
