<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- 页头：返回 + 这一格 / Cell · 周五 午 12 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:minHeight="56dp"
        android:paddingStart="@dimen/page"
        android:paddingEnd="@dimen/page"
        android:paddingTop="3dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/btn_cell_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_round_white"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cell_title"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_cell" />

            <TextView
                android:id="@+id/cell_sub"
                style="@style/Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cell" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 这一格合计 + 笔数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:paddingStart="@dimen/page"
                android:paddingEnd="@dimen/page"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cell_label"
                        style="@style/Bills.CellLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cell_total" />

                    <TextView
                        android:id="@+id/cell_total"
                        style="@style/Text.BigNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="¥0.00" />
                </LinearLayout>

                <TextView
                    android:id="@+id/cell_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:includeFontPadding="false"
                    android:fontFeatureSettings="tnum"
                    android:text="0 笔"
                    android:textColor="@color/ink3"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/cell_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <!-- 逐笔列表（行尾 × 删除） -->
            <LinearLayout
                android:id="@+id/cell_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page"
                android:paddingEnd="@dimen/page"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/cell_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingStart="@dimen/page"
                android:paddingEnd="@dimen/page"
                android:paddingTop="34dp"
                android:paddingBottom="34dp"
                android:text="这一格还没有记录"
                android:textColor="@color/ink3"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 再记一笔 -->
            <TextView
                android:id="@+id/btn_cell_add"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/page"
                android:layout_marginEnd="@dimen/page"
                android:layout_marginTop="18dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="@string/cell_add" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
