<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- 页头：返回 + 这一笔 / Entry Detail · 10 月 23 日 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:minHeight="56dp"
        android:paddingStart="@dimen/page"
        android:paddingEnd="@dimen/page"
        android:paddingTop="3dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/btn_detail_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_round_white"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_title"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_detail" />

            <TextView
                android:id="@+id/detail_sub"
                style="@style/Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Entry Detail" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page"
            android:paddingEnd="@dimen/page"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/detail_cat"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="餐饮 · 支出" />

            <!-- 大金额 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="3dp"
                    android:paddingBottom="5dp"
                    android:includeFontPadding="false"
                    android:text="¥"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_amount"
                    style="@style/Text.BigNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00" />
            </LinearLayout>

            <!-- 坐标胶囊：周五 · 午 12 -->
            <TextView
                android:id="@+id/detail_coord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bills_tag_coord"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="周五 · 午 12"
                android:textColor="@color/blue_deep"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/detail_rows_top"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/detail_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                style="@style/Row"
                android:background="@drawable/bills_hairline_row">

                <TextView
                    style="@style/Bills.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_note" />

                <TextView
                    android:id="@+id/detail_note"
                    style="@style/Bills.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Row"
                android:background="@drawable/bills_hairline_row">

                <TextView
                    style="@style/Bills.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_date" />

                <TextView
                    android:id="@+id/detail_date"
                    style="@style/Bills.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Row"
                android:background="@drawable/bills_hairline_row">

                <TextView
                    style="@style/Bills.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_time" />

                <TextView
                    android:id="@+id/detail_time"
                    style="@style/Bills.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Row"
                android:background="@drawable/bills_hairline_row">

                <TextView
                    style="@style/Bills.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_source" />

                <TextView
                    android:id="@+id/detail_source"
                    style="@style/Bills.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Row"
                android:background="@drawable/bills_hairline_row">

                <TextView
                    style="@style/Bills.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_created" />

                <TextView
                    android:id="@+id/detail_created"
                    style="@style/Bills.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Row"
                android:background="@drawable/bills_hairline_row">

                <TextView
                    style="@style/Bills.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_raw" />

                <TextView
                    android:id="@+id/detail_raw"
                    style="@style/Bills.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            
            </LinearLayout>

            <!-- 编辑 / 删除 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_detail_edit"
                    style="@style/Btn.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/edit" />

                <TextView
                    android:id="@+id/btn_detail_delete"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bills_btn_danger"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/delete"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 这一格的其他笔 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingBottom="10dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/detail_same_title"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="@string/detail_same" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/detail_same_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:textColor="@color/ink"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_same_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
