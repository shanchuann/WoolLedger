<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 页头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/report_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_round_white"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/report_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="月度总结"
                android:textColor="@color/ink"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/report_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="Monthly Receipt"
                android:textColor="@color/ink3"
                android:textSize="11.5sp"
                android:textStyle="italic" />
        </LinearLayout>

        <View
            android:layout_width="34dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 日报 / 周报 / 月报 -->
    <LinearLayout
        android:id="@+id/rep_seg"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:orientation="horizontal"
        android:padding="1dp">

        <TextView
            android:id="@+id/seg_day"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="日报"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seg_week"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="周报"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seg_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="月报"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 打印机 + 纸面 -->
    <LinearLayout
        android:id="@+id/printer_device"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pd_body"
            android:layout_width="match_parent"
            android:layout_height="72dp">

            <View
                android:id="@+id/pd_glass"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="24dp" />

            <TextView
                android:id="@+id/pd_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="13dp"
                android:layout_marginBottom="23dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:text="WOOL · TP-58"
                android:textColor="#6BFFFFFF"
                android:textSize="8sp" />

            <FrameLayout
                android:id="@+id/pd_slot"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/pd_led"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-1dp"
                    android:layout_marginEnd="9dp" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/paper_wrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/paper_stage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <FrameLayout
                    android:id="@+id/paper_inner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="96dp">

                    <com.wool.ledger.view.ReceiptView
                        android:id="@+id/receipt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </FrameLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/print_think"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/think_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="蓝羊羊正在写总结"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/think_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:text="读取账本…"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 底部操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btn_again"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="重新生成"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="复制总结"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
