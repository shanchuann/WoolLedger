<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 标题：21sp / 黑体 / 紧字距（与预览一致） -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- 副标题：衬线斜体，对应预览里的 Dear ledger, -->
    <style name="Text.Sub" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/ink3</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">italic</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Second" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink2</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 小标签：10sp 加宽字距 -->
    <style name="Text.Label" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/ink3</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 大数字 -->
    <style name="Text.BigNum" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 卡片：纸白 + 发丝线 + 14dp 圆角 -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Btn.Primary" parent="">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Ghost" parent="">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 一行：左标签 + 右值 + 发丝线 -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/row_h</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 与 claude.ai 一致：不打包字体，直接用系统无衬线（中文即思源黑体/苹方），
         字重收在 medium / normal 两档，避免 heavy 的“标题字”感 -->
    <style name="WoolTextBase" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 全站 Activity 切换统一用系统 fade（进场/退场、打开/关闭都是淡入淡出） -->
    <style name="WoolWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>